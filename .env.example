# Node.js >=22.13. No subir .env.local al repositorio.
DATABASE_URL=file:./data/cms.sqlite
STORAGE_PROVIDER=local
UPLOAD_DIR=./data/uploads

ADMIN_EMAIL= 
# Generar con npm run auth:hash, usando ADMIN_PASSWORD temporalmente en el entorno.
ADMIN_PASSWORD_HASH=
# Solo para desarrollo; preferir el hash incluso en local.
# ADMIN_PASSWORD=
# Origen exacto público si se usa proxy inverso, por ejemplo https://colegio.example.
ADMIN_ORIGIN=
# Generar con: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# PostgreSQL: reemplazar DATABASE_URL; no desactivar validación TLS.
# DATABASE_URL=postgresql://usuario:password@localhost:5432/yangtse
# STORAGE_PROVIDER=supabase
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=colegio-documentos

